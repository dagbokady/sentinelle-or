# Base de données — SQLite par défaut (dev local), PostGIS en production
# DATABASE_URL=postgresql+psycopg2://sentinelle:sentinelle@localhost:5432/sentinelle

# Sentinel-2 via Earth Search (AWS/Element84) : AUCUN compte requis — fournisseur par défaut.

# Sentinel-2 via Copernicus Data Space (optionnel)
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# Landsat 8/9 via USGS M2M (optionnel)
USGS_USER=
USGS_TOKEN=

# API
CORS_ORIGINS=*
